{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-success-puzzle",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-success-puzzle-db",
      "database_id": "5f48627a-4464-4166-9e00-c59e5ce94dfa",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "ai-success-puzzle-books"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "BOOK_OBJECT_KEY": "books/success-puzzle-v1.pdf",
    "APP_NAME": "AI 성공의 퍼즐조각"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
